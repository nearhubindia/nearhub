# Server deploy configuration for scripts/deploy-server-ec2.sh
# Copy this file to .env.deploy and adjust values for your environment.

# EC2 connection
EC2_HOST=65.2.151.47
EC2_USER=admin
EC2_PORT=22

# Local SSH private key used for manual deployment
EC2_KEY_PATH=/home/pavanprasad/Downloads/nearhub/nearhub-debian-key-20260524-015812.pem

# EC2 runtime layout
APP_DIR=/opt/nearhub-server
ENV_FILE=/etc/nearhub/server.env

# Artifact runtime defaults
COMPOSE_PROJECT_NAME=nearhub
COMPOSE_FILE_NAME=docker-compose.prod.yml
DOCKERFILE_NAME=Dockerfile.prod
SYSTEMD_UNIT_NAME=nearhub-stack.service

# Backend Firebase Admin SDK path on the server host
# Example runtime value used in prod: /etc/nearhub/firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/nearhub/firebase-admin.json
