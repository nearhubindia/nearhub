# NearHub Backend Server - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# Environment & Server Configuration
# ============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Server port
SERVER_PORT=5000

# Server host
SERVER_HOST=localhost

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:Synvide%40123@localhost:5432/nearhub

# If the server container uses host networking on Linux, localhost works
# for both PostgreSQL and Redis on the host:
# DATABASE_URL=postgresql://postgres:Synvide%40123@localhost:5432/nearhub

# Database connection pool settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# ============================================================================
# CORS Configuration
# ============================================================================

# Allowed origins (comma-separated)
# Examples: http://localhost:3000,http://localhost:5173,https://app.nearhub.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Enable CORS for local development
CORS_ALLOW_LOCALHOST=true

# Enable CORS for local network (192.168.*, 10.*, 172.*)
CORS_ALLOW_LOCAL_NETWORK=true

# ============================================================================
# OTP & SMS Configuration
# ============================================================================

# Enable BSNL DLT service
BSNL_DLT_ENABLED=false

# BSNL portal credentials
BSNL_DLT_USERNAME=your_bsnl_email_or_username
BSNL_DLT_PASSWORD=your_bsnl_password

# BSNL Sender ID
BSNL_DLT_SENDER_ID=NRHUB

# BSNL Route type (1=Transactional, 2=Promotional)
BSNL_DLT_ROUTE=1

# BSNL OTP Template ID (pre-registered with BSNL)
BSNL_DLT_TEMPLATE_ID=1234567890

# MSG91 SMS Gateway Configuration (Alternative provider)
MSG91_ENABLED=true

# MSG91 API Key
MSG91_API_KEY=your_msg91_api_key

# MSG91 Sender ID
MSG91_SENDER_ID=NRHUB

# MSG91 Route type (4=Transactional)
MSG91_ROUTE=4

# MSG91 DLT Template ID (required for India transactional OTP SMS)
MSG91_TEMPLATE_ID=your_msg91_template_id

# MSG91 OTP API v5 template ID (optional; if set, v5 OTP API will be used first)
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id

# Optional: exact Flow variable key for OTP placeholder (example: otp, VAR1, Param1)
MSG91_FLOW_OTP_KEY=otp

# ============================================================================
# OTP Service Configuration
# ============================================================================

# OTP validity in minutes
OTP_VALIDITY_MINUTES=5

# Maximum verification attempts per OTP
OTP_MAX_ATTEMPTS=3

# Rate limiting: max send requests per phone in time window
OTP_RATE_LIMIT_REQUESTS=5

# Rate limiting: time window in seconds (default: 3600 = 1 hour)
OTP_RATE_LIMIT_WINDOW=3600

# Demo login override for app review (Google Play, QA)
# Set DEMO_LOGIN_ENABLED=false to disable
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_PHONE=9876543210
DEMO_LOGIN_OTP=123456

# ============================================================================
# Payment Gateway Configuration (Razorpay)
# ============================================================================

# Razorpay Key ID (recommended variable)
RAZORPAY_KEY_ID=your_razorpay_key_id

# Razorpay Key Secret (recommended variable)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay webhook secret configured in Razorpay dashboard webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay API Key
RAZORPAY_API_KEY=your_razorpay_api_key

# Razorpay API Secret
RAZORPAY_API_SECRET=your_razorpay_api_secret

# For production, keep both naming schemes in sync:
#   RAZORPAY_KEY_ID   <-> RAZORPAY_API_KEY
#   RAZORPAY_KEY_SECRET <-> RAZORPAY_API_SECRET
# The server accepts either pair, but having both set avoids deploy drift.

# Razorpay Account ID (for webhook verification)
RAZORPAY_ACCOUNT_ID=your_account_id

# ============================================================================
# Geo-location & Geo-search Configuration
# ============================================================================

# Default geo-search radius in kilometers
DEFAULT_GEO_RADIUS_KM=10

# Maximum geo-search radius in kilometers
MAX_GEO_RADIUS_KM=50

# ============================================================================
# Caching & Performance
# ============================================================================

# Redis configuration (for caching, sessions, etc.)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# If Redis is published to the host from Docker, point the server at localhost:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6380

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# ============================================================================
# Search & Indexing Configuration
# ============================================================================

# Elasticsearch enable/disable
ELASTICSEARCH_ENABLED=false

# Elasticsearch host
ELASTICSEARCH_HOST=localhost:9200

# Elasticsearch index name
ELASTICSEARCH_INDEX_NAME=nearhub-listings

# ============================================================================
# File Storage Configuration
# ============================================================================

# Storage type: 'local' or 'cloud' (AWS S3, Google Cloud Storage, etc.)
STORAGE_TYPE=local

# Local storage path (for development)
LOCAL_STORAGE_PATH=/tmp/nearhub-storage

# AWS S3 Configuration (if STORAGE_TYPE=aws)
AWS_S3_BUCKET=your_bucket_name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================================================
# AI & ML Configuration
# ============================================================================

# Google GenAI API Key (for content analysis, recommendations, etc.)
GOOGLE_GENAI_API_KEY=your_google_genai_api_key
# Optional: use Vertex AI auth instead of API key
# When true, server uses application default credentials / bound service account.
GOOGLE_GENAI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=global

# Enable/disable AI features
AI_FEATURES_ENABLED=true

# Listing moderation provider: gemini | aws
AI_MODERATION_PROVIDER=gemini

# Voice-over script provider: aws | google
# `aws` keeps script as provided title/highlights/description context and avoids Gemini dependency.
AI_SCRIPT_PROVIDER=aws

# Voice-over translation provider: google | aws
AI_TRANSLATION_PROVIDER=aws

# Voice-over TTS uses standard Google Cloud Text-to-Speech API
# You can keep this same as GOOGLE_GENAI_API_KEY if enabled for Cloud TTS, or use a separate key.
GOOGLE_TTS_API_KEY=your_google_tts_api_key
AI_TTS_VOICE_TELUGU=te-IN-Standard-A
AI_TTS_VOICE_KANNADA=kn-IN-Standard-A
AI_TTS_VOICE_HINDI=hi-IN-Standard-A
AI_TTS_VOICE_ENGLISH=en-IN-Standard-A

AI_VOICEOVER_ENHANCE_VIDEO=true
AI_VOICEOVER_BGM_SOURCE=builtin-cinematic
AI_VOICEOVER_BGM_VOLUME=0.30
AI_VOICEOVER_OUTPUT_WIDTH=1080
AI_VOICEOVER_OUTPUT_CRF=21
AI_VOICEOVER_OUTPUT_PRESET=medium

# Optional confidence threshold for AWS Rekognition moderation labels
AWS_REKOGNITION_MIN_CONFIDENCE=75

# AWS video moderation frame sampling controls
AWS_VIDEO_MODERATION_FRAME_INTERVAL_SECONDS=2
AWS_VIDEO_MODERATION_MAX_FRAMES=12
AWS_VIDEO_MODERATION_MAX_VIDEOS=2

# ============================================================================
# Admin Configuration
# ============================================================================

# Admin user default email
ADMIN_DEFAULT_EMAIL=admin@nearhub.local

# Admin user default password (should be changed on first login)
ADMIN_DEFAULT_PASSWORD=admin@123

# Admin JWT secret key
ADMIN_JWT_SECRET=your_very_secure_admin_jwt_secret_key_change_this_in_production

# Admin JWT expiration time (e.g., 7d, 24h)
ADMIN_JWT_EXPIRES_IN=24h

# ============================================================================
# Logging & Monitoring
# ============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable access logs
ACCESS_LOGS_ENABLED=true

# Enable debug namespaces (comma-separated; use app:* to enable all)
DEBUG=app:*

# ============================================================================
# Email Configuration (for notifications, etc.)
# ============================================================================

# Email service provider (e.g., sendgrid, mailgun, smtp)
EMAIL_PROVIDER=smtp

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@nearhub.com
SMTP_FROM_NAME=NearHub

# ============================================================================
# Feature Flags
# ============================================================================

# Enable listing expiration feature
LISTING_EXPIRATION_ENABLED=true

# Listing expiration period in days
LISTING_EXPIRATION_DAYS=60

# Enable subscription system
SUBSCRIPTIONS_ENABLED=true

# Enable spam detection
SPAM_DETECTION_ENABLED=true

# ============================================================================
# Cloudflare Deployment Configuration
# ============================================================================

# API token used by Wrangler/Cloudflare API (do NOT commit real value)
CLOUDFLARE_API_TOKEN=placeholder-token

# Cloudflare account ID used for Workers/Pages/R2 deploys
CLOUDFLARE_ACCOUNT_ID=account-id

# Cloudflare R2 direct upload configuration
CLOUDFLARE_R2_ENABLED=false
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_BUCKET=your_r2_bucket
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ============================================================================
# Data Retention Worker
# ============================================================================

# Used by data-retention-cleanup worker (disabled by default in scheduler)
LISTING_VIEWS_RETENTION_DAYS=90
NOTIFICATION_LOGS_RETENTION_DAYS=30

# Public CDN/base URL used to serve uploaded files
# Example: https://cdn.nearhub.com
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://cdn.example.com

# Presigned URL expiry in seconds
CLOUDFLARE_R2_PRESIGN_EXPIRES_SECONDS=900

# Upload limits
CLOUDFLARE_R2_MAX_IMAGE_BYTES=10485760
CLOUDFLARE_R2_MAX_VIDEO_BYTES=314572800
