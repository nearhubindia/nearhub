{
  "name": "nearhub-server",
  "version": "1.0.0",
  "description": "NearHub backend API server",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx -e \"process.env.NODE_ENV='development'; await import('./index.ts')\"",
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --sourcemap --outdir=dist && node scripts/ensure-sourcemap-file.mjs dist/index.js.map index.js && mkdir -p dist/templates && cp -r templates/* dist/templates/",
    "prod": "node -e \"process.env.NODE_ENV='production'; import('./dist/index.js')\"",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest __tests__/features/auth.test.ts",
    "test:listings": "jest __tests__/features/listings.test.ts",
    "test:coupons": "jest __tests__/features/coupons.test.ts",
    "test:subscriptions": "jest __tests__/features/subscriptions.test.ts",
    "test:users": "jest __tests__/features/users.test.ts",
    "test:admin-reports": "jest __tests__/features/admin-reports.test.ts",
    "test:messages": "jest __tests__/features/messages.test.ts",
    "test:in-app-notifications": "jest __tests__/features/in-app-notifications.test.ts",
    "test:listings-search": "jest __tests__/features/listings-search.test.ts",
    "test:all": "jest --coverage --verbose",
    "test:strict": "jest --verbose --detectOpenHandles --runInBand",
    "quality:release": "npm run type-check && npm run lint && npm run test:strict",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:create": "npm exec --yes --package=drizzle-kit@0.31.10 -- drizzle-kit generate --config=drizzle.config.js",
    "db:status": "npm exec --yes --package=drizzle-kit@0.31.10 -- drizzle-kit check --config=drizzle.config.js",
    "db:generate": "npm exec --yes --package=drizzle-kit@0.31.10 -- drizzle-kit generate --config=drizzle.config.js",
    "db:push": "npm exec --yes --package=drizzle-kit@0.31.10 -- drizzle-kit push --config=drizzle.config.js",
    "db:refresh": "bash scripts/refresh-db.sh",
    "seed": "tsx scripts/seed-subscription-tiers.ts",
    "seed:users": "tsx scripts/seed.ts",
    "seed:listings": "tsx scripts/seed-db-listings.ts",
    "seed:deals": "tsx scripts/seed-deals.ts",
    "location:import": "tsx scripts/import-location-index.ts",
    "migrate:starter-credits": "tsx scripts/apply-starter-credits-migration.ts",
    "seed:expired-listing": "tsx scripts/seed-expired-listing.ts",
    "search:sync": "tsx scripts/sync-elasticsearch.ts",
    "backfill:transactions": "tsx scripts/backfill-transactions.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1045.0",
    "@aws-sdk/client-polly": "^3.1045.0",
    "@aws-sdk/client-rekognition": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/client-translate": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@elastic/elasticsearch": "^9.3.1",
    "@google/genai": "^1.42.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "debug": "^4.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "expo-server-sdk": "^6.0.0",
    "express": "^5.0.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.10.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.16.3",
    "redis": "^4.6.13",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "ws": "^8.21.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.48.0"
  },
  "overrides": {
    "esbuild": "^0.28.0",
    "test-exclude": "^7.0.1",
    "gaxios": "^7.3.0",
    "uuid": "^11.1.1",
    "teeny-request": "^10.1.4",
    "rimraf": "^6.0.1",
    "glob": "^13.0.6",
    "node-domexception": "npm:domexception@^4.0.0"
  },
  "private": true
}
