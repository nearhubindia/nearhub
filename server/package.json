{
  "name": "nearhub-server",
  "version": "1.0.0",
  "description": "NearHub backend API server",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx index.ts",
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --sourcemap --outdir=dist && node scripts/ensure-sourcemap-file.mjs dist/index.js.map index.js",
    "prod": "NODE_ENV=production node dist/index.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest __tests__/features/auth.test.ts",
    "test:listings": "jest __tests__/features/listings.test.ts",
    "test:coupons": "jest __tests__/features/coupons.test.ts",
    "test:subscriptions": "jest __tests__/features/subscriptions.test.ts",
    "test:users": "jest __tests__/features/users.test.ts",
    "test:all": "jest --coverage --verbose",
    "db:migrate": "node --import tsx/esm scripts/migrate.ts create",
    "db:create": "node --import tsx/esm scripts/migrate.ts create",
    "db:status": "node --import tsx/esm scripts/migrate.ts status",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:push": "drizzle-kit push --config=drizzle.config.js",
    "seed": "tsx scripts/seed-subscription-tiers.ts",
    "seed:users": "tsx scripts/seed.ts",
    "seed:listings": "tsx scripts/seed-db-listings.ts",
    "location:import": "tsx scripts/import-location-index.ts",
    "seed:expired-listing": "tsx scripts/seed-expired-listing.ts",
    "search:sync": "tsx scripts/sync-elasticsearch.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@elastic/elasticsearch": "^9.3.1",
    "@google/genai": "^1.42.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "debug": "^4.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "expo-server-sdk": "^6.0.0",
    "express": "^5.0.1",
    "express-rate-limit": "^8.2.1",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.16.3",
    "redis": "^4.6.13",
    "tsx": "^4.20.6",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/debug": "^4.1.12",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.21.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.48.0"
  },
  "private": true
}
