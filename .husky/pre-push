#!/bin/sh

echo "🔍 Running per-project quality checks before push..."
echo ""

echo "🏛️  Running architecture gate..."
node scripts/gates/architecture-gate.mjs || {
  echo "❌ architecture gate failed!"
  exit 1
}
echo ""

echo "🧱 Running framework gate..."
node scripts/gates/framework-gate.mjs || {
  echo "❌ framework gate failed!"
  exit 1
}
echo ""

run_app=0
run_server=0
run_web=0

# Check against upstream if available; fallback to last commit.
if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
  CHANGED_FILES="$(git diff --name-only @{u}...HEAD)"
else
  CHANGED_FILES="$(git diff --name-only HEAD~1..HEAD 2>/dev/null || true)"
fi

if [ -z "$CHANGED_FILES" ]; then
  run_app=1
  run_server=1
  run_web=1
else
  echo "$CHANGED_FILES" | grep -qE '^app/' && run_app=1
  echo "$CHANGED_FILES" | grep -qE '^server/' && run_server=1
  echo "$CHANGED_FILES" | grep -qE '^web/' && run_web=1
fi

if [ "$run_app" -eq 1 ]; then
  echo "📱 Checking app/"
  (
    cd app &&
      npm run type-check &&
      npm run lint &&
      npm run format:check
  ) || {
    echo "❌ app quality check failed!"
    exit 1
  }
  echo ""
fi

if [ "$run_server" -eq 1 ]; then
  echo "🖥️  Checking server/"
  (
    cd server &&
      npm run type-check &&
      npm run lint &&
      npm run format:check
  ) || {
    echo "❌ server quality check failed!"
    exit 1
  }
  echo ""
fi

if [ "$run_web" -eq 1 ]; then
  echo "🌐 Checking web/"
  (
    cd web &&
      npm run type-check &&
      npm run lint &&
      npm run format:check
  ) || {
    echo "❌ web quality check failed!"
    exit 1
  }
  echo ""
fi

echo ""
echo "✅ All quality checks passed!"
