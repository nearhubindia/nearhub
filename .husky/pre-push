#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running full quality check before push..."
echo ""

echo "📝 Type checking..."
npm run type-check || { echo "❌ Type check failed!"; exit 1; }

echo ""
echo "🔍 Linting..."
npm run lint || { echo "❌ Lint check failed!"; exit 1; }

echo ""
echo "✨ Format checking..."
npm run format:check || { echo "❌ Format check failed! Run 'npm run format' to fix."; exit 1; }

echo ""
echo "✅ All quality checks passed!"
