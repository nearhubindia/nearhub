FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci && npm cache clean --force

COPY dist ./dist
COPY migrations ./migrations
COPY scripts ./scripts
COPY drizzle.config.js ./
COPY data ./data

EXPOSE 5000

CMD ["npm", "run", "prod"]
