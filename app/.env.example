# NearHub Mobile App - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL (e.g., http://localhost:5000 or https://api.nearhub.in)
# This is used to construct the full API endpoint
EXPO_PUBLIC_API_URL=http://localhost:5000

# Domain for local development (alternative to API_URL)
# Used by config.ts to construct API_URL dynamically
# Format: 192.168.x.x:5000 or localhost:5000
EXPO_PUBLIC_DOMAIN=localhost:5000

# Public website URL used for share links (defaults to https://nearhub.in)
EXPO_PUBLIC_WEB_URL=https://nearhub.in

# App install URL used in shared messages (defaults to Play Store listing)
EXPO_PUBLIC_APP_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=com.synvide.nearhub&pcampaignid=web_share

# ============================================================================
# Feature Flags
# ============================================================================

# Enable debug logging
EXPO_PUBLIC_DEBUG=true

# Enable offline mode (defaults to false)
EXPO_PUBLIC_OFFLINE_MODE=false

# Cache stale time in milliseconds (default: 300000 = 5 minutes)
EXPO_PUBLIC_CACHE_STALE_TIME=300000

# ============================================================================
# Geo-location Configuration
# ============================================================================

# Default geo-radius in kilometers from admin settings (overridden at runtime)
EXPO_PUBLIC_DEFAULT_GEO_RADIUS_KM=10

# ============================================================================
# File Upload Configuration
# ============================================================================

# Max image upload size in MB
EXPO_PUBLIC_MAX_IMAGE_SIZE_MB=10

# Max video upload size in MB
EXPO_PUBLIC_MAX_VIDEO_SIZE_MB=500

# Image compression quality (0-1)
EXPO_PUBLIC_IMAGE_COMPRESSION_QUALITY=0.8

# Video compression target size in MB
EXPO_PUBLIC_VIDEO_COMPRESSION_TARGET_MB=100

# ============================================================================
# Pagination & Performance
# ============================================================================

# Default page size for listings
EXPO_PUBLIC_LISTINGS_PAGE_SIZE=20

# Default page size for search results
EXPO_PUBLIC_SEARCH_PAGE_SIZE=20

# Infinite scroll threshold in pixels
EXPO_PUBLIC_INFINITE_SCROLL_THRESHOLD=500

# Enable haptic feedback while swiping shorts (default false for smoother scroll)
EXPO_PUBLIC_SHORTS_SWIPE_HAPTICS=false

# ============================================================================
# APK Local Build Overrides
# ============================================================================

# Optional overrides for: npm run build:apk
# Default config source is app/release/build-config.env

# Build/version controls
VERSION_CODE=56
VERSION_NAME=1.3.12
MIN_SDK_VERSION=24
ANDROID_ENABLE_MINIFY_IN_RELEASE_BUILDS=true

# Optional: enforce expected upload certificate SHA1 (uppercase colon-separated).
EXPECTED_UPLOAD_SHA1=DF:38:D8:51:51:3E:10:8C:D6:6C:DC:2C:7B:95:93:32:04:7D:3A:3E

# Optional CLI pin
EAS_CLI_VERSION=18.4.0

# Optional for local testing only:
# If true, SHA1 mismatch is treated as warning (debug signing likely).
ALLOW_DEBUG_RELEASE_SIGNING=true

# ============================================================================
# Firebase / Analytics / Push
# ============================================================================

# Firebase Analytics and push notifications are configured through:
# - app/google-services.json
# - app/android/app/google-services.json
# - the Firebase project settings in the console
#
# Keep those files aligned with the active Firebase project when rotating keys.
