{
  "expo": {
    "name": "NearHub",
    "slug": "nearhub",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nearhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/near_hub_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.synvide.nearhub",
      "splash": {
        "image": "./assets/images/near_hub_splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0F1A"
      }
    },
    "android": {
      "package": "com.synvide.nearhub",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1a2332",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/images/near_hub_splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0F1A"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "./plugins/withCleartextTraffic",
      "./plugins/withFullScreenSplash",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "owner": "pavanprasadnarla",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0583b34d-a357-4d7d-9321-fdca13a59a43"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/0583b34d-a357-4d7d-9321-fdca13a59a43"
    }
  }
}
