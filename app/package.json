{
  "name": "nearhub-app",
  "main": "expo-router/entry",
  "version": "1.3.15",
  "description": "NearHub mobile app (Expo/React Native)",
  "scripts": {
    "dev": "npx expo start --clear --lan",
    "dev:metro": "./run-android.sh",
    "web": "npx expo start --web --localhost --clear",
    "start": "npx expo start --web --localhost --clear",
    "android": "npm run type-check && expo run:android",
    "android:dev": "npm run type-check && expo run:android",
    "ios": "npm run type-check && expo run:ios",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality-check": "npm run type-check && npm run lint && npm run format:check",
    "pre-build": "npm run quality-check",
    "build:aab": "bash ./scripts/build-aab.sh",
    "postinstall": "patch-package",
    "build:apk": "bash ./scripts/build-apk-local.sh"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^24.1.1",
    "@react-native-firebase/app": "^24.1.1",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@ungap/structured-clone": "^1.3.0",
    "axios": "^1.13.5",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "expo": "~54.0.34",
    "expo-av": "^16.0.8",
    "expo-battery": "^57.0.1",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.10",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "^18.2.1",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-print": "^57.0.1",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-video-thumbnails": "^10.0.8",
    "expo-web-browser": "~15.0.11",
    "jsonwebtoken": "^9.0.3",
    "nativewind": "^4.2.2",
    "p-limit": "^7.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-razorpay": "2.3.0",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.4.19",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "patch-package": "^8.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    },
    "install": {
      "exclude": [
        "react-native-keyboard-controller"
      ]
    }
  },
  "private": true
}
