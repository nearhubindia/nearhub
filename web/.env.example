# NearHub Web Admin Portal - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL (e.g., http://localhost:5000 or https://api.nearhub.com)
VITE_API_URL=http://localhost:5000

# ============================================================================
# Feature Flags & Configuration
# ============================================================================

# Enable debug mode
VITE_DEBUG=true

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# ============================================================================
# Admin Dashboard Configuration
# ============================================================================

# Default page size for listings in admin dashboard
VITE_ADMIN_LISTINGS_PAGE_SIZE=20

# Default page size for users in admin dashboard
VITE_ADMIN_USERS_PAGE_SIZE=20

# Default page size for coupons
VITE_ADMIN_COUPONS_PAGE_SIZE=20

# Default page size for spam reports
VITE_ADMIN_SPAM_REPORTS_PAGE_SIZE=20

# ============================================================================
# Pricing & Subscription Configuration
# ============================================================================

# Minimum listing price threshold (free listings below this)
VITE_MIN_PRICE_FOR_PAID_LISTING=3000

# Currency symbol
VITE_CURRENCY_SYMBOL=₹

# Currency code
VITE_CURRENCY_CODE=INR

# ============================================================================
# UI Configuration
# ============================================================================

# Application name
VITE_APP_NAME=NearHub Admin

# Application title
VITE_APP_TITLE=NearHub Platform Administration

# Support email
VITE_SUPPORT_EMAIL=support@nearhub.com

# ============================================================================
# Deployment & Build Configuration
# ============================================================================

# Base URL for routing (useful for sub-path deployments)
VITE_BASE_URL=/

# Canonical website URL used for SEO tags and sitemap links
VITE_SITE_URL=https://nearhub.in
