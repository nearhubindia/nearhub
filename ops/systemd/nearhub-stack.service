[Unit]
Description=Nearhub Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nearhub-server
ExecStart=/usr/bin/docker-compose -p nearhub -f /opt/nearhub-server/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker-compose -p nearhub -f /opt/nearhub-server/docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
