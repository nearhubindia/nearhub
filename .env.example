# NearHub Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================================================
# BSNL DLT Configuration (OTP via SMS)
# ============================================================================
# Register at: https://dlt.bsnl-pts.in
# Documentation: See docs/BSNL_DLT_INTEGRATION.md

# Enable/disable BSNL DLT service (true/false)
BSNL_DLT_ENABLED=false

# BSNL portal login credentials
BSNL_DLT_USERNAME=your_bsnl_email_or_username
BSNL_DLT_PASSWORD=your_bsnl_password

# Your registered BSNL Sender ID (e.g., "NRHUB", "NEARHUB")
BSNL_DLT_SENDER_ID=NRHUB

# Route type: 1 = Transactional, 2 = Promotional (default: 1)
BSNL_DLT_ROUTE=1

# Pre-registered OTP template ID from BSNL
# Get this from BSNL DLT portal after registering template
BSNL_DLT_TEMPLATE_ID=1234567890

# ============================================================================
# OTP Service Configuration
# ============================================================================

# OTP validity in seconds (default: 300 = 5 minutes)
OTP_VALIDITY_MINUTES=5

# Maximum verification attempts per OTP (default: 3)
OTP_MAX_ATTEMPTS=3

# Rate limiting: max send requests per phone in window (default: 5)
OTP_RATE_LIMIT_REQUESTS=5

# Rate limiting: time window in seconds (default: 3600 = 1 hour)
OTP_RATE_LIMIT_WINDOW=3600

# ============================================================================
# Server Configuration
# ============================================================================

# Node environment
NODE_ENV=development

# Server port
PORT=5000

# Server host
HOST=0.0.0.0

# ============================================================================
# Database Configuration
# ============================================================================

# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/nearhub

# ============================================================================
# AI Services Configuration
# ============================================================================

# Google GenAI API Configuration
AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Enable Phi2 AI validation
AI_ENABLE_PHI2_VALIDATION=true

# ============================================================================
# Redis Cache Configuration
# ============================================================================

# Redis connection URL (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Redis cache TTL in seconds (default: 300 = 5 minutes)
REDIS_CACHE_TTL=300

# ============================================================================
# Razorpay Payment Configuration
# ============================================================================

# Test Keys (replace with production keys for live)
RAZORPAY_KEY_ID=rzp_test_1234567890
RAZORPAY_KEY_SECRET=test_secret_key

# ============================================================================
# AWS S3 Configuration (for file uploads)
# ============================================================================

# AWS Region
AWS_REGION=ap-south-1

# S3 Bucket name
AWS_S3_BUCKET=nearhub-bucket

# AWS Access Key ID
AWS_ACCESS_KEY_ID=your_access_key

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================================================
# JWT Configuration
# ============================================================================

# Admin JWT Secret (change in production!)
ADMIN_JWT_SECRET=your-super-secret-key-change-in-production

# User JWT Secret (change in production!)
USER_JWT_SECRET=another-super-secret-key-change-in-production

# JWT Expiration (default: 7d for admin, 30d for users)
JWT_EXPIRES_IN=7d

# ============================================================================
# Email Configuration
# ============================================================================

# Email service provider (smtp, sendgrid, mailgun)
EMAIL_PROVIDER=smtp

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Sender email address
SENDER_EMAIL=noreply@nearhub.com
SENDER_NAME=NearHub

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log directory
LOG_DIR=./logs

# ============================================================================
# API Configuration
# ============================================================================

# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,https://nearhub.com

# API rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=100

# ============================================================================
# Feature Flags
# ============================================================================

# Enable spam detection
ENABLE_SPAM_DETECTION=true

# Enable dynamic pricing
ENABLE_DYNAMIC_PRICING=true

# Enable caching
ENABLE_CACHING=true

# ============================================================================
# Development/Testing
# ============================================================================

# Test phone number (bypasses real OTP for testing)
TEST_PHONE=9876543210

# Mock SMS in development (logs instead of sending)
MOCK_SMS=true

# Debug mode
DEBUG=nearhub:*
